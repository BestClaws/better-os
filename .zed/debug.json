[
  {
    "type": "probe-rs-debug",
    "request": "launch",
    "name": "Launch",
    "chip": "esp32c3",
    "flashingConfig": {
      "flashingEnabled": true,
      "haltAfterReset": false,
      "formatOptions": {
        "binaryFormat": "idf"
      }
    },
    "coreConfigs": [
